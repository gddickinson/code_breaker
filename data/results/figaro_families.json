    {
     "image": "1881_18811119-ZZ.jpg",
     "date": "1881-11-19",
     "signature": "ZZ",
     "key": "2217",
     "reading": "Ai lettre, merci, mais ecris ... t'adore, s'ennuie de [toi?]. Je baise tes levres, ma cherie."
    },
    {
     "image": "1882_18820601-5.jpg",
     "date": "1882-06-01",
     "signature": "5",
     "key": "2217",
     "reading": "Pourquoi pas ecrire? Fa[i]tes grand peine [a votre] amie."
    },
    {
     "image": "1882_18820701-5.jpg",
     "date": "1882-07-01",
     "signature": "5",
     "key": "2217",
     "reading": "Aime moi un peu je taime et desire tant te baiser (from the transcription lquh uiq sg vhs eh blquh hb fhdqch blgb bh klqdhc)"
    },
    {
     "image": "1882_18821224-5.jpg",
     "date": "1882-12-24",
     "signature": "5",
     "key": "2217",
     "reading": "Triste adieu si froid. T'aime quand meme, te desire follemen[t], te baise partout, ma Berthe cherie."
    }
